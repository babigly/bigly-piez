KEY=/etc/bigly-offpi/id_ed25519
FOLDERS="biglybank=/home/bigly/biglybank-backups biglydex-v2=/home/bigly/biglydex-v2/backups biglycraft=/home/bigly/biglycraft-data/backups bigly-games=/home/bigly/bigly-games/data/backups"
EXCLUDE="*-hourly*"
